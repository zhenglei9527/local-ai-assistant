<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a speech bubble containing a small node graph,
  standing for "chat backed by a local model". Vector rather than PNG so it
  costs no density buckets and stays sharp at every launcher size.

  The 108x108 viewport is the adaptive-icon contract; the safe zone is the
  central 72x72, so all artwork is kept inside roughly x/y 22..86.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speech bubble outline. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,32 L74,32 A10,10 0 0 1 84,42 L84,64 A10,10 0 0 1 74,74 L52,74 L38,86 L38,74 L34,74 A10,10 0 0 1 24,64 L24,42 A10,10 0 0 1 34,32 Z" />

    <!-- Three nodes of a tiny network, knocked out of the bubble. -->
    <path
        android:fillColor="#FF1F6FEB"
        android:pathData="M40,47 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path
        android:fillColor="#FF1F6FEB"
        android:pathData="M62,42 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path
        android:fillColor="#FF1F6FEB"
        android:pathData="M54,62 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!-- Edges between the nodes. -->
    <path
        android:strokeColor="#FF1F6FEB"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M44,46 L58,43" />
    <path
        android:strokeColor="#FF1F6FEB"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M43,51 L51,58" />
    <path
        android:strokeColor="#FF1F6FEB"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M60,46 L56,57" />
</vector>
